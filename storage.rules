rules_version = '2';

// Firebase Storage rules for receipt attachments.
// Files live under receipts/{uid}/… — only the owner (the uid that uploaded
// them) may write or delete. Reads happen through tokenized download URLs, but
// we still restrict rule-based reads to the owner. A 10 MB per-file cap and an
// image/PDF content-type check keep abuse and storage cost down.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
