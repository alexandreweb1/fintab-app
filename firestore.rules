rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the document being written declares the caller as owner.
    function isCreatingOwnDoc() {
      return request.resource.data.userId == request.auth.uid;
    }

    // True when the existing document belongs to the caller.
    function isOwnerOfExistingDoc() {
      return resource.data.userId == request.auth.uid;
    }

    // True when the signed-in user is a collaborator of the document owner.
    // Reads the caller's user profile to check masterUserId.
    function isCollaboratorOfOwner() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return 'masterUserId' in profile && profile.masterUserId == resource.data.userId;
    }

    // True when a collaborator is creating a doc on behalf of their master.
    function isCollaboratorCreatingMastersDoc() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return 'masterUserId' in profile && profile.masterUserId == request.resource.data.userId;
    }

    // Lower-cased email of the caller. Errors (no email on the token) make the
    // calling rule evaluate to false, which is the safe default.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // ── Workspace ("Carteira" PF/PJ) helpers ──────────────────────────────────
    // A workspace is a self-contained ledger. Ledger docs carry a workspaceId;
    // access is granted by membership on the workspace doc (owner is ALWAYS a
    // member with role 'editor'). The legacy() branches keep pre-migration
    // clients and docs (no workspaceId field) working exactly as before — they
    // are removed in the final cutover phase.

    function wsData(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    function isWorkspaceMember(wid) {
      return request.auth.uid in wsData(wid).memberUids;
    }

    function isWorkspaceEditor(wid) {
      return wsData(wid).roles[request.auth.uid] == 'editor';
    }

    function wsOwner(wid) {
      return wsData(wid).ownerId;
    }

    // Read: doc belongs to a workspace and the caller is a member (viewer or
    // editor). && short-circuits, so docs without the field never hit wsData().
    function wsReadable() {
      return 'workspaceId' in resource.data
          && isWorkspaceMember(resource.data.workspaceId);
    }

    // Write on an existing doc: member with role 'editor'.
    function wsEditable() {
      return 'workspaceId' in resource.data
          && isWorkspaceEditor(resource.data.workspaceId);
    }

    // Create: doc declares a workspace, the caller is an editor there, and the
    // doc is homed to the workspace owner's uid (never the collaborator's).
    function wsCreatable() {
      return 'workspaceId' in request.resource.data
          && isWorkspaceEditor(request.resource.data.workspaceId)
          && request.resource.data.userId == wsOwner(request.resource.data.workspaceId);
    }

    // Pre-workspace access paths (owner or account-wide collaborator).
    function legacyAccess() {
      return isOwnerOfExistingDoc() || isCollaboratorOfOwner();
    }

    function legacyCreate() {
      return isCreatingOwnDoc() || isCollaboratorCreatingMastersDoc();
    }

    // AUDIT FIX: a doc may never be re-homed to another uid on update.
    function userIdUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    // True when the profile write that sets masterUserId is authorized by an
    // accepted invitation addressed to the caller. The profile write must
    // reference the invitation via masterInvitationId. getAfter() sees the
    // state after the whole batch, so the acceptInvitation batch (invitation
    // update + profile write) validates atomically.
    function invitationAuthorizesLink() {
      let inv = getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.masterInvitationId)).data;
      return inv.masterUserId == request.resource.data.masterUserId
          && inv.inviteeEmail == callerEmail()
          && inv.status == 'accepted'
          && inv.collaboratorUserId == request.auth.uid
          // A workspace-scoped invitation grants membership of ONE Carteira
          // (via the acceptWorkspaceInvite Cloud Function) and must NEVER
          // authorize the account-wide masterUserId link.
          && !('workspaceId' in inv);
    }

    // Validates client writes to the subscription doc. This does NOT replace
    // server-side receipt validation (a forged write can still claim a short
    // subscription) — it caps the damage: no perpetual expiry, no arbitrary
    // fields, no fake products, and updatedAt must be the server timestamp.
    //
    // We deliberately do NOT gate on purchaseToken length: a restored purchase
    // may deliver an empty/short serverVerificationData on some platforms, and
    // rejecting it here would lock a paying user out of Pro. The length check
    // also adds ~no security (an attacker pads a longer string trivially) —
    // the real boundary is server-side receipt validation.
    // Purchase fields (type/productId/expiryDate/purchaseToken) are required and
    // validated ONLY when status == 'active'. An 'expired' write (e.g. clearing a
    // lapsed subscription) may legitimately carry just {status, updatedAt}, so we
    // must not dereference the purchase fields unconditionally — doing so would
    // raise an evaluation error and deny the clear.
    function validSubscription() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'status', 'purchaseToken', 'productId', 'expiryDate', 'updatedAt'])
          && d.get('status', '') in ['active', 'expired']
          && d.updatedAt == request.time
          && (d.get('status', '') != 'active' || (
                'type' in d && d.type in ['monthly', 'annual']
                && 'purchaseToken' in d && d.purchaseToken is string
                && 'productId' in d && d.productId in ['pro_monthly', 'pro_annual']
                && 'expiryDate' in d && d.expiryDate is timestamp
                && d.expiryDate < request.time + duration.value(400, 'd')
             ));
    }

    // ── /users/{userId} ───────────────────────────────────────────────────────
    // Each user can read/write their own profile, BUT masterUserId may only be
    // set when an accepted invitation authorizes the link — otherwise any user
    // could point masterUserId at a victim's uid and gain full access to their
    // data through the collaborator rules below.
    match /users/{userId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && request.auth.uid == userId
        && (!('masterUserId' in request.resource.data) || invitationAuthorizesLink());

      allow update: if isSignedIn() && request.auth.uid == userId
        && (
          // masterUserId untouched by this write
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['masterUserId'])
          // leaving a shared account (field removed)
          || !('masterUserId' in request.resource.data)
          // linking to a master — requires a matching accepted invitation
          || invitationAuthorizesLink()
        );

      // The master may detach a collaborator: remove the link fields, nothing else.
      allow update: if isSignedIn()
        && resource.data.masterUserId == request.auth.uid
        && !('masterUserId' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['masterUserId', 'masterInvitationId']);
    }

    // ── /workspaces/{workspaceId} ─────────────────────────────────────────────
    // A "Carteira" (PF/PJ ledger space). Members read; ONLY the owner mutates
    // (rename/archive/membership seeding/revoke). The one privilege-sensitive
    // mutation — an invitee adding THEMSELVES with an owner-assigned role — is
    // done by the acceptWorkspaceInvite Cloud Function (Admin SDK), never here.
    match /workspaces/{workspaceId} {
      allow read:   if isSignedIn()
                    && (resource.data.ownerId == request.auth.uid
                        || request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids
                    && request.resource.data.roles[request.auth.uid] == 'editor';
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── Ledger collections (dual-path during the workspace transition) ────────
    // New path: workspace membership (viewer reads, editor writes), docs homed
    // to the workspace owner. Legacy path: pre-migration behavior, unchanged.
    // userIdUnchanged() on update is the audit fix (no cross-user re-homing).

    // ── /transactions/{transactionId} ─────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /categories/{categoryId} ──────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /budgets/{budgetId} ───────────────────────────────────────────────────
    match /budgets/{budgetId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /wallets/{walletId} ───────────────────────────────────────────────────
    match /wallets/{walletId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /goals/{goalId} ──────────────────────────────────────────────────────
    match /goals/{goalId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /recurring_transactions/{recurringId} ────────────────────────────────
    match /recurring_transactions/{recurringId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /category_rules/{ruleId} ─────────────────────────────────────────────
    match /category_rules/{ruleId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /bills/{billId} ──────────────────────────────────────────────────────
    match /bills/{billId} {
      allow read:   if isSignedIn() && (wsReadable() || legacyAccess());
      allow create: if isSignedIn() && (wsCreatable()
                        || (legacyCreate() && !('workspaceId' in request.resource.data)));
      allow update: if isSignedIn() && userIdUnchanged()
                        && (wsEditable() || legacyAccess());
      allow delete: if isSignedIn() && (wsEditable() || legacyAccess());
    }

    // ── /investment_assets/{assetId} & /investment_trades/{tradeId} ───────────
    // Portfolio tracker (assets tracked + buy/sell trades). Owner or
    // collaborator; userId pinned on create and immutable on update.
    match /investment_assets/{assetId} {
      allow read, delete: if isSignedIn() && (isOwnerOfExistingDoc() || isCollaboratorOfOwner());
      allow update:       if isSignedIn() && (isOwnerOfExistingDoc() || isCollaboratorOfOwner())
                          && request.resource.data.userId == resource.data.userId;
      allow create:       if isSignedIn() && (isCreatingOwnDoc() || isCollaboratorCreatingMastersDoc());
    }
    match /investment_trades/{tradeId} {
      allow read, delete: if isSignedIn() && (isOwnerOfExistingDoc() || isCollaboratorOfOwner());
      allow update:       if isSignedIn() && (isOwnerOfExistingDoc() || isCollaboratorOfOwner())
                          && request.resource.data.userId == resource.data.userId;
      allow create:       if isSignedIn() && (isCreatingOwnDoc() || isCollaboratorCreatingMastersDoc());
    }

    // ── /subscriptions/{userId} ───────────────────────────────────────────────
    // Document ID == userId; only the owner can read/write their subscription.
    // Writes are field-validated (see validSubscription). Delete is allowed so
    // account deletion can wipe the doc.
    match /subscriptions/{userId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
        && validSubscription();
    }

    // ── /notification_backlog/{docId} ────────────────────────────────────────
    // Only the owning user can read/write their own backlog items.
    match /notification_backlog/{docId} {
      allow read, update, delete: if isSignedIn() && isOwnerOfExistingDoc();
      allow create:               if isSignedIn() && isCreatingOwnDoc();
    }

    // ── /invitations/{invitationId} ───────────────────────────────────────────
    // Master: creates 'pending' invitations for their own account, may change
    //         only the status afterwards (e.g. 'removed'), and may delete.
    // Invitee: can read invitations sent to their email and answer a pending
    //          one (accept/decline), recording only their own uid. The
    //          masterUserId and inviteeEmail fields are immutable — otherwise
    //          an invitee could redirect an invitation at a victim's account.
    match /invitations/{invitationId} {
      allow create: if isSignedIn()
                    && request.resource.data.masterUserId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    // Workspace-scoped invites must declare a valid role and
                    // reference a workspace the inviter actually owns.
                    && (!('workspaceId' in request.resource.data)
                        || (request.resource.data.role in ['viewer', 'editor']
                            && wsOwner(request.resource.data.workspaceId) == request.auth.uid));

      allow read:   if isSignedIn()
                    && (resource.data.masterUserId == request.auth.uid
                        || resource.data.inviteeEmail == callerEmail());

      // Master: status changes, plus stamping workspaceId/role during the
      // workspace migration (scoping a legacy account-wide invite to the
      // default Carteira). masterUserId/inviteeEmail remain immutable.
      allow update: if isSignedIn()
                    && resource.data.masterUserId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'workspaceId', 'role'])
                    && (!('role' in request.resource.data)
                        || request.resource.data.role in ['viewer', 'editor']);

      // Invitee: answer a pending invitation (or re-confirm their own accept).
      // ACCEPT via client is LEGACY-ONLY (account-wide invites without a
      // workspaceId). Workspace-scoped accepts go through the
      // acceptWorkspaceInvite Cloud Function; the client may still decline.
      allow update: if isSignedIn()
                    && resource.data.inviteeEmail == callerEmail()
                    && (resource.data.status == 'pending'
                        || (resource.data.status == 'accepted'
                            && resource.data.collaboratorUserId == request.auth.uid))
                    && request.resource.data.status in ['accepted', 'declined']
                    && (request.resource.data.status == 'declined'
                        || !('workspaceId' in resource.data))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'collaboratorUserId'])
                    && (!('collaboratorUserId' in request.resource.data)
                        || request.resource.data.collaboratorUserId == request.auth.uid);

      allow delete: if isSignedIn()
                    && resource.data.masterUserId == request.auth.uid;
    }

    // ── /referralCodes/{code} ─────────────────────────────────────────────────
    // Public code → uid map so an invitee can resolve who referred them.
    // Holds no PII. Each user creates only their own code; codes are immutable.
    match /referralCodes/{code} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── /referralRewards/{inviteeId} ──────────────────────────────────────────
    // Ledger of granted referral rewards. Written ONLY by the Cloud Function
    // (Admin SDK bypasses rules); clients may read their own entry, never write.
    match /referralRewards/{inviteeId} {
      allow read:  if isSignedIn()
                   && (request.auth.uid == inviteeId
                       || resource.data.referrerId == request.auth.uid);
      allow write: if false;
    }

    // ── /referralStats/{userId} ───────────────────────────────────────────────
    // Anti-fraud reward counter. Written ONLY by the Cloud Function so a
    // referrer can't reset it from the client to bypass the cap.
    match /referralStats/{userId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
